     "action": "filter_rows",
     "condition_expression": "String(row['Major'] || '').toLowerCase().includes('art')"
   }

   For DELETING rows that match a condition:
   {
     "action": "delete_rows",
     "condition_expression": "String(row['Status'] || '').toLowerCase() === 'cancelled'"
   }

